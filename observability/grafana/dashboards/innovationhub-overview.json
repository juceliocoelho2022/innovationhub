  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "innovationhub-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"innovationhub-backend\"}[1m]))",
          "refId": "A"
        }
      ],
      "title": "HTTP Throughput",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "innovationhub-prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"innovationhub-backend\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"innovationhub-backend\"}[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "innovationhub-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{job=\"innovationhub-backend\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"innovationhub-backend\"}[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "title": "Mean HTTP Latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "innovationhub-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "id": 4,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"innovationhub-backend\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "innovationhub-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
